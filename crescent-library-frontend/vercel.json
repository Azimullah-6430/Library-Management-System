{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/config.js",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/config.js"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "https://library-management-system-bm2m.onrender.com/api/v1/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://library-management-system-bm2m.onrender.com/api/$1"
    },
    {
      "src": "/health",
      "dest": "https://library-management-system-bm2m.onrender.com/health"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://library-management-system-bm2m.onrender.com/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
